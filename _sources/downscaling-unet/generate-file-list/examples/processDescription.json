  "inputs": {
    "start_datetime": {
      "description": "Start datetime in ISO 8601 format, for example 2024-05-01T07:00:00.",
      "minOccurs": 1,
      "maxOccurs": 1,
      "schema": {
        "type": "string"
      },
      "literalDataDomains": [
        {
          "default": true,
          "dataType": {
            "name": "string"
          },
          "valueDefinition": {
            "anyValue": false
          }
        }
      ]
    },
    "end_datetime": {
      "description": "End datetime in ISO 8601 format, for example 2024-05-01T08:00:00.",
      "minOccurs": 1,
      "maxOccurs": 1,
      "schema": {
        "type": "string"
      },
      "literalDataDomains": [
        {
          "default": true,
          "dataType": {
            "name": "string"
          },
          "valueDefinition": {
            "anyValue": false
          }
        }
      ]
    },
    "requires_previous_forecast_step": {
      "description": "Whether the previous forecast step is required. Must be true for cumulative variables,\nsuch as precipitation.\n",
      "minOccurs": 0,
      "maxOccurs": 1,
      "schema": {
        "type": "boolean",
        "default": true
      },
      "literalDataDomains": [
        {
          "default": true,
          "defaultValue": true,
          "dataType": {
            "name": "boolean"
          },
          "valueDefinition": {
            "anyValue": false
          }
        }
      ]
    },
    "include_year_month_subdirectory": {
      "description": "Whether the file paths include the year/month subdirectory, as on thredds (true),\nor are stored in a flat directory (false).\n",
      "minOccurs": 0,
      "maxOccurs": 1,
      "schema": {
        "type": "boolean",
        "default": true
      },
      "literalDataDomains": [
        {
          "default": true,
          "defaultValue": true,
          "dataType": {
            "name": "boolean"
          },
          "valueDefinition": {
            "anyValue": false
          }
        }
      ]
    },
    "data_root": {
      "description": "Root location prepended to each listed file. Set to an empty string to get relative paths.\n",
      "minOccurs": 0,
      "maxOccurs": 1,
      "schema": {
        "type": "string",
        "default": "https://pavics.ouranos.ca/twitcher/ows/proxy/thredds/fileServer/birdhouse/disk3/ouranos/geoconnections/RDPS/"
      },
      "literalDataDomains": [
        {
          "default": true,
          "defaultValue": "https://pavics.ouranos.ca/twitcher/ows/proxy/thredds/fileServer/birdhouse/disk3/ouranos/geoconnections/RDPS/",
          "dataType": {
            "name": "string"
          },
          "valueDefinition": {
            "anyValue": false
          }
        }
      ]
    }
  },
  "outputs": {
    "forecast_files": {
      "title": "forecast_files",
      "schema": {
        "oneOf": [
          {
            "type": "string",
            "contentMediaType": "text/plain"
          },
          {
            "type": "string",
            "contentMediaType": "text/html"
          },
          {
            "type": "string",
            "format": "binary",
            "contentMediaType": "application/pdf",
            "contentEncoding": "base64"
          }
        ]
      },
      "formats": [
        {
          "default": true,
          "mediaType": "text/plain"
        },
        {
          "mediaType": "text/html"
        },
        {
          "mediaType": "application/pdf"
        }
      ]
    }
  },
  "jobControlOptions": [
    "async-execute"
  ],
  "outputTransmission": [
    "reference",
    "value"
  ]
}
