{
  "id": "ogc-ospd2026-downscaling-unet",
  "version": "0.1.3.dev10",
  "title": "RDPS-to-HRDPS climate downscaling with a U-Net",
  "description": "Runs the Resoterre U-Net inference workflow to downscale RDPS forecast data to HRDPS resolution.",
  "inputs": {
    "start_datetime": {
      "title": "Start datetime",
      "description": "Start of the RDPS forecast interval in ISO 8601 format.",
      "schema": {"type": "string"},
      "minOccurs": 1,
      "maxOccurs": 1
    },
    "end_datetime": {
      "title": "End datetime",
      "description": "End of the RDPS forecast interval in ISO 8601 format.",
      "schema": {"type": "string"},
      "minOccurs": 1,
      "maxOccurs": 1
    },
    "requires_previous_forecast_step": {
      "title": "Requires previous forecast step",
      "schema": {"type": "boolean", "default": true},
      "minOccurs": 0,
      "maxOccurs": 1
    },
    "include_year_month_subdirectory": {
      "title": "Include year/month subdirectory",
      "schema": {"type": "boolean", "default": true},
      "minOccurs": 0,
      "maxOccurs": 1
    },
    "data_root": {
      "title": "RDPS data root",
      "schema": {"type": "string", "format": "uri"},
      "minOccurs": 0,
      "maxOccurs": 1
    },
    "config": {
      "title": "Inference configuration",
      "schema": {"type": "string", "contentMediaType": "application/yaml"},
      "minOccurs": 0,
      "maxOccurs": 1
    }
  },
  "outputs": {
    "forecast_files": {
      "title": "Forecast file list",
      "schema": {"type": "string", "contentMediaType": "text/plain"}
    },
    "inference_output": {
      "title": "Inference output",
      "schema": {"type": "string", "contentMediaType": "application/vnd+zarr"}
    }
  },
  "jobControlOptions": ["async-execute"],
  "outputTransmission": ["value", "reference"]
}
