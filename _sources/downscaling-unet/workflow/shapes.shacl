@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pp: <https://crim-ca.github.io/bblocks-process-profiles/def/> .
@prefix mlact: <https://w3id.org/ogc/rim/ml-activity/> .
@prefix mlm: <https://w3id.org/ogc/stac/mlm/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix binding: <https://crim-ca.github.io/bblocks-process-profiles/def/model-binding/downscaling-unet/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pp:ModelSpatialDomainShape a sh:NodeShape ;
    sh:targetNode binding:model-spatial-domain ;
    sh:class geo:Geometry ;
    sh:property [
        sh:path geo:asWKT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype geo:wktLiteral
    ] .

pp:ModelTemporalDomainShape a sh:NodeShape ;
    sh:targetNode binding:model-temporal-domain ;
    sh:class time:ProperInterval ;
    sh:property [ sh:path time:hasBeginning ; sh:hasValue binding:model-start ; sh:maxCount 1 ] ;
    sh:property [ sh:path time:hasEnd ; sh:hasValue binding:model-end ; sh:maxCount 1 ] .

pp:ModelTemporalEndpointShape a sh:NodeShape ;
    sh:targetNode binding:model-start, binding:model-end ;
    sh:class time:Instant ;
    sh:property [
        sh:path time:inXSDDateTimeStamp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTimeStamp
    ] .

pp:ModelApplicabilityShape a sh:NodeShape ;
    sh:targetNode
        <https://crim-ca.github.io/bblocks-process-profiles/def/activity-type/climate-downscaling-inference> ;
    sh:property [ sh:path dct:spatial ; sh:hasValue binding:model-spatial-domain ] ;
    sh:property [ sh:path dct:temporal ; sh:hasValue binding:model-temporal-domain ] .

pp:EntityModelDomainShape a sh:NodeShape ;
    sh:targetClass
        <https://crim-ca.github.io/bblocks-process-profiles/def/entity-type/RDPSModelInput>,
        <https://crim-ca.github.io/bblocks-process-profiles/def/entity-type/HRDPSGeophysicalInput>,
        <https://crim-ca.github.io/bblocks-process-profiles/def/entity-type/HRDPSPrediction> ;
    sh:property [ sh:path pp:modelSpatialDomain ; sh:hasValue binding:model-spatial-domain ] ;
    sh:property [ sh:path pp:modelTemporalDomain ; sh:hasValue binding:model-temporal-domain ] .

pp:InferenceExecutionShape a sh:NodeShape ;
    sh:targetClass pp:InferenceExecution ;
    sh:property [
        sh:path dct:type ;
        sh:hasValue
            <https://crim-ca.github.io/bblocks-process-profiles/def/activity-type/climate-downscaling-inference>
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:hasValue
            <https://hirondelle.crim.ca/stac/collections/stac-mlm-examples/items/ogc-ospd2026-downscaling-unet>
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:qualifiedValueShape [ sh:class mlact:ActivityInput ] ;
        sh:qualifiedMinCount 2
    ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasGeneratedBy ] ;
        sh:qualifiedValueShape [ sh:class mlact:ActivityOutput ] ;
        sh:qualifiedMinCount 1
    ] ;
    sh:property [
        sh:path dct:subject ;
        sh:hasValue mlm:downscaling
    ] ;
    sh:property [
        sh:path dct:subject ;
        sh:hasValue mlm:super-resolution
    ] .

pp:ModelBindingShape a sh:NodeShape ;
    sh:targetClass oa:SpecificResource ;
    sh:property [
        sh:path oa:hasSource ;
        sh:hasValue
            <https://hirondelle.crim.ca/stac/collections/stac-mlm-examples/items/ogc-ospd2026-downscaling-unet>
    ] ;
    sh:property [
        sh:path oa:hasSelector ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oa:FragmentSelector ;
        sh:node [
            sh:property [ sh:path dct:conformsTo ; sh:hasValue <https://www.rfc-editor.org/rfc/rfc6901> ] ;
            sh:property [
                sh:path rdf:value ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:in (
                    "/properties/mlm:input/0" "/properties/mlm:input/1" "/properties/mlm:output/0"
                    "/properties/mlm:input/0/input" "/properties/mlm:input/1/input"
                    "/properties/mlm:output/0/result" "/geometry"
                    "/properties/start_datetime" "/properties/end_datetime"
                )
            ]
        ]
    ] .
