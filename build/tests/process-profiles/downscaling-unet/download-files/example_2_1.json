  "inputs": {
    "file_list": {
      "title": "file_list",
      "description": "Text file holding one file reference per line.",
      "minOccurs": 1,
      "maxOccurs": 1,
      "schema": {
        "type": "string",
        "contentMediaType": "text/plain"
      },
      "formats": [
        {
          "default": true,
          "mediaType": "text/plain"
        }
      ]
    }
  },
  "outputs": {
    "input_data": {
      "title": "input_data",
      "description": "Directory holding the downloaded files, ready to be used as the UNet input_data.",
      "schema": {
        "type": "string",
        "format": "binary",
        "contentMediaType": "application/directory",
        "contentEncoding": "base64"
      },
      "formats": [
        {
          "default": true,
          "mediaType": "application/directory"
        }
      ]
    }
  },
  "jobControlOptions": [
    "async-execute"
  ],
  "outputTransmission": [
    "reference",
    "value"
  ]
