{
  "id": "ogc-ospd2026-downscaling-unet-workflow",
  "version": "0.1.3.dev10",
  "title": "RDPS-to-HRDPS climate downscaling with a U-Net",
  "description": "Chain the RDPS forecast file listing with the UNet downscaling inference.\nThe first step derives the RDPS files required for the requested datetime range,\nthe second step downloads them into a local directory and the last step runs the\ninference on that directory.\n",
