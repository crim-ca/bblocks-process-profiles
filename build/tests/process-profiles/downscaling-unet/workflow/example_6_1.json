            "rlat",
            "rlon"
          ]
        },
        "variables": [
          "orog",
          "sftlf"
        ],
        "description": "Static orography and land-fraction channels on the 512x512 target grid. The geographic lat/lon are auxiliary coordinates over rlat/rlon."
