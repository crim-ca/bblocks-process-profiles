    :properties [ ns7:dimensions [ :rlat [ a :spatial ;
                            dct:description "Row coordinate of the 512x512 HRDPS target array in its rotated-pole grid. The geographic positions are provided by the two-dimensional lat/lon auxiliary coordinates." ;
                            :axis "y" ;
                            :extent 0,
                                511 ;
                            :unit "index" ] ;
                    :rlon [ a :spatial ;
                            dct:description "Column coordinate of the 512x512 HRDPS target array in its rotated-pole grid. The geographic positions are provided by the two-dimensional lat/lon auxiliary coordinates." ;
                            :axis "x" ;
                            :extent 0,
                                511 ;
                            :unit "index" ] ;
                    :time [ a :temporal ;
                            dct:description "Valid time associated with each independently processed model sample." ;
                            :extent "2017-05-22T07:00:00Z",
                                "2100-12-31T23:59:59Z" ;
                            :unit "s" ] ] ;
            ns7:variables [ :GZ500 [ a :data ;
                            dct:description "RDPS geopotential height at 500 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :GZ850 [ a :data ;
                            dct:description "RDPS geopotential height at 850 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :HRDPS_P_PR_SFC [ a :data ;
                            dct:description "HRDPS precipitation rate at the surface, reconstructed on the target grid." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :HRDPS_P_TT_10000 [ a :data ;
                            dct:description "HRDPS air temperature at 10 m, reconstructed on the target grid." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :HRDPS_P_UUC_10000 [ a :data ;
                            dct:description "HRDPS eastward wind component at 10 m, reconstructed on the target grid." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :HRDPS_P_VVC_10000 [ a :data ;
                            dct:description "HRDPS northward wind component at 10 m, reconstructed on the target grid." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :HU700 [ a :data ;
                            dct:description "RDPS relative humidity at 700 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :HU850 [ a :data ;
                            dct:description "RDPS relative humidity at 850 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :PC [ a :data ;
                            dct:description "RDPS convective precipitation at the surface, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :PN [ a :data ;
                            dct:description "RDPS pressure at the surface, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :PR [ a :data ;
                            dct:description "RDPS precipitation rate at the surface, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :TD [ a :data ;
                            dct:description "RDPS dew-point temperature, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :TT850 [ a :data ;
                            dct:description "RDPS air temperature at 850 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :TT_model_levels [ a :data ;
                            dct:description "RDPS air temperature on model levels, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :UU850 [ a :data ;
                            dct:description "RDPS eastward wind component at 850 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :UU_model_levels [ a :data ;
                            dct:description "RDPS eastward wind component on model levels, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :VV850 [ a :data ;
                            dct:description "RDPS northward wind component at 850 hPa, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :VV_model_levels [ a :data ;
                            dct:description "RDPS northward wind component on model levels, normalized before inference." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon",
                                "time" ] ;
                    :lat [ a :auxiliary ;
                            dct:description "Geographic latitude auxiliary coordinate for the rotated grid." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon" ;
                            :unit "degree_north" ] ;
                    :lon [ a :auxiliary ;
                            dct:description "Geographic longitude auxiliary coordinate for the rotated grid." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon" ;
                            :unit "degree_east" ] ;
                    :orog [ a :data ;
                            dct:description "Static HRDPS orography on the target rotated grid, aligned to the output patch." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon" ] ;
                    :sftlf [ a :data ;
                            dct:description "Static HRDPS land-fraction field on the target rotated grid, aligned to the output patch." ;
                            :data_type "float32" ;
                            :dimensions "rlat",
                                "rlon" ] ] ;
            dct:description "U-Net trained to downscale RDPS meteorological data to HRDPS resolution." ;
            dct:title "RDPS-to-HRDPS U-Net downscaling inference" ;
            :end_datetime "2100-12-31T23:59:59Z" ;
            :experimental true ;
            :license "Apache-2.0" ;
            :providers [ dct:description "Deployment host and inference-container processor." ;
                    :name "CRIM" ;
                    :roles "host",
                        "processor" ;
                    :url "https://www.crim.ca/" ],
                [ dct:description "Producer and licensor of the model." ;
                    :name "Ouranos" ;
                    :roles "licensor",
                        "producer" ;
                    :url "https://www.ouranos.ca/" ] ;
            :start_datetime "2017-05-22T07:00:00Z" ;
            ns4:accelerator "cuda" ;
            ns4:accelerator_constrained false ;
            ns4:architecture "U-Net" ;
            ns4:framework "pytorch" ;
            ns4:framework_version "2.14.0+cu130" ;
            ns4:hyperparameters [ :coarsen_factor 4 ;
                    :depth 2 ;
                    :device "cpu" ;
                    :global_end_datetime "2024-09-01 12:00:00" ;
                    :global_start_datetime "2017-05-22 07:00:00" ;
                    :initial_nb_of_hidden_channels 144 ;
                    :kernel_size 3 ;
                    :learning_rate 2e-03 ;
                    :mae_loss_weight 0e+00 ;
                    :mass_loss_weight 0e+00 ;
                    :mse_loss_weight 5e-01 ;
                    :nb_of_epochs 18 ;
                    :num_threads 16 ;
                    :num_workers 8 ;
                    :optimizer "Adam" ;
                    :reduction_ratio 4 ;
                    :ssim_k1 1e-02 ;
                    :ssim_k2 3e-02 ;
                    :ssim_kernel_size 11 ;
                    :ssim_loss_weight 5e-01 ;
                    :ssim_sigma 1.5e+00 ;
                    :test_period_start "2023-06-01 00:00:00" ;
                    :training_batch_size 64 ;
                    :validation_period_start "2023-01-10 00:00:00" ;
                    :weight_decay "1e-05" ] ;
            ns4:input [ dct:description "Static orography and land-fraction channels on the 512x512 target grid. The geographic lat/lon are auxiliary coordinates over rlat/rlon." ;
                    :input [ :data_type "float32" ;
                            :dim_order "batch",
                                "rlat",
                                "rlon",
                                "variables" ;
                            :shape -1,
                                2,
                                512 ] ;
                    :name "hrdps_geophysical_inputs" ;
                    :variables "orog",
                        "sftlf" ],
                [ dct:description "Fourteen normalized RDPS meteorological channels on the 128x128 coarse rotated grid. Each flexible batch element represents one independently selected valid time. The time identifies samples in the surrounding dataset but is not a tensor axis because the U-Net does not jointly process a temporal sequence." ;
                    :input [ :data_type "float32" ;
                            :dim_order "batch",
                                "rlat",
                                "rlon",
                                "variables" ;
                            :shape -1,
                                14,
                                128 ] ;
                    :name "rdps_inputs" ;
                    :variables "GZ500",
                        "GZ850",
                        "HU700",
                        "HU850",
                        "PC",
                        "PN",
                        "PR",
                        "TD",
                        "TT850",
                        "TT_model_levels",
                        "UU850",
                        "UU_model_levels",
                        "VV850",
                        "VV_model_levels" ] ;
            ns4:name "UNet RDPS HRDPS Downscaling" ;
            ns4:output [ dct:description "Four continuous HRDPS fields reconstructed for the same valid time on the 512x512 target rotated grid." ;
                    :name "hrdps_outputs" ;
                    :result [ :data_type "float32" ;
                            :dim_order "batch",
                                "rlat",
                                "rlon",
                                "variables" ;
                            :shape -1,
                                4,
                                512 ] ;
                    :tasks "downscaling",
                        "super-resolution" ;
                    :variables "HRDPS_P_PR_SFC",
                        "HRDPS_P_TT_10000",
                        "HRDPS_P_UUC_10000",
                        "HRDPS_P_VVC_10000" ] ;
            ns4:pretrained false ;
            ns4:tasks "downscaling",
                "super-resolution" ;
            ns4:total_parameters 9871888 ;
            ns6:version "0.1.3-dev.10" ;
            ns8:citation "Gauvin St-Denis, B., and Smith, T. J. resoterre (version 0.1.3-dev.10). Ouranos." ;
            ns3:branch "main" ;
            ns3:revision "f08a79b9a1906a8752c5774b050e90f81f2d1bcb" ;
            ns3:tag "v0.1.3-dev.10" ;
            ns3:type "git" ] ;
