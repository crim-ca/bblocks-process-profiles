{
  "@context": {
    "@vocab": "https://crim-ca.github.io/bblocks-process-profiles/def/",
    "inputs": {
      "@context": {
        "@vocab": "https://w3id.org/ogc/api/processes/",
        "schema": {
          "@context": {
            "@vocab": "https://w3id.org/ogc/api/schema/"
          },
          "@id": "proc:schema"
        },
        "type": "proc:type"
      }
    },
    "outputs": {
      "@context": {
        "@vocab": "https://w3id.org/ogc/api/processes/",
        "schema": {
          "@context": {
            "@vocab": "https://w3id.org/ogc/api/schema/"
          },
          "@id": "proc:schema"
        },
        "type": "proc:type"
      }
    },
    "id": "@id",
    "cwl": {
      "@id": "pp:cwl",
      "@type": "@id"
    },
    "type": "@type",
    "title": "dct:title",
    "description": "dct:description",
    "version": "pp:version",
    "process": {
      "@id": "pp:process",
      "@type": "@id"
    },
    "executionUnit": {
      "@id": "proc:executionUnit",
      "@type": "@id"
    },
    "href": "@id",
    "activityTypes": {
      "@id": "pp:activityType",
      "@type": "@id",
      "@container": "@set"
    },
    "inRegister": {
      "@id": "rim:inRegister",
      "@type": "@id"
    },
    "source": "pp:source",
    "cwlClass": "pp:cwlClass",
    "cwlId": "pp:cwlId",
    "keywords": "proc:keywords",
    "nullable": "proc:nullable",
    "$ref": {
      "@id": "proc:ref",
      "@type": "@id"
    },
    "default": {
      "@id": "proc:default",
      "@type": "@json"
    },
    "enum": {
      "@id": "proc:enum",
      "@container": "@set"
    },
    "minOccurs": "proc:minOccurs",
    "maxOccurs": "proc:maxOccurs",
    "dct": "http://purl.org/dc/terms/",
    "proc": "https://w3id.org/ogc/api/processes/",
    "rim": "https://w3id.org/ogc/rim/",
    "mlact": "rim:ml-activity/",
    "geoproc": "rim:geoprocessing/",
    "@version": 1.1
  }
}